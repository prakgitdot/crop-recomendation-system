# Copy this file to .env for local development if you want to override defaults.
# Cloud platforms (e.g. Render) set PORT automatically — you do not need to set it there.

# Port the Flask dev server listens on (used only when running `python app.py` locally)
PORT=5000

# Set to "true" to enable Flask debug mode locally. NEVER set this to true in production.
FLASK_DEBUG=false
